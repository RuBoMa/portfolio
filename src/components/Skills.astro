---

<section class="max-w-4xl mx-auto my-12 px-4">
  <h2 class="text-3xl font-bold mb-8 text-center">Skills</h2>

  <div class="mb-8">
    <h3
      class="text-lg font-semibold text-gray-400 mb-4 text-center uppercase tracking-wider"
    >
      Development
    </h3>
    <div class="flex flex-wrap justify-center gap-4">
      {
        devSkills.map((skill) => (
          <div
            class={`${skill.color} text-white px-4 py-3 rounded-xl shadow-lg transition-all duration-300 transform hover:scale-105 hover:shadow-xl flex items-center gap-3 min-w-fit`}
          >
            <img
              src={skill.logo}
              alt={`${skill.name} logo`}
              class="w-6 h-6 object-contain"
              loading="lazy"
            />
            <span class="text-sm font-medium">{skill.name}</span>
          </div>
        ))
      }
    </div>
  </div>

  <div>
    <h3
      class="text-lg font-semibold text-gray-400 mb-4 text-center uppercase tracking-wider"
    >
      Cybersecurity
    </h3>
    <div class="flex flex-wrap justify-center gap-4">
      {
        cyberSkills.map((skill) => (
          <div
            class={`${skill.color} text-white px-4 py-3 rounded-xl shadow-lg transition-all duration-300 transform hover:scale-105 hover:shadow-xl flex items-center gap-3 min-w-fit`}
          >
            <img
              src={skill.logo}
              alt={`${skill.name} logo`}
              class="w-6 h-6 object-contain"
              loading="lazy"
            />
            <span class="text-sm font-medium">{skill.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
